# Base de données (Neon / Vercel Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk (auth + Organizations)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# IA
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email du propriétaire de l'app (accès à /admin/feedback, toutes organisations confondues)
OWNER_EMAIL=

# Digest hebdomadaire par email (optionnel — sans ces variables, le cron ne fait rien)
RESEND_API_KEY=
DIGEST_FROM_EMAIL="ImmoScript AI <digest@votredomaine.fr>"
# Secret partagé avec le déclencheur cron (ex: Vercel Cron), pour authentifier
# GET /api/cron/weekly-digest sans passer par une session Clerk.
CRON_SECRET=

# Stripe — laisser vide tant que le compte Stripe réel n'est pas branché : la facturation
# répond alors 501 (billing_not_configured) au lieu de planter (voir lib/billing/stripe.ts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID (mode "subscription") de chaque plan payant — voir lib/billing/plans.ts pour la grille
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# URL publique de l'app, utilisée en repli si l'en-tête Origin est absent (ex: certains webhooks
# ou requêtes server-to-server) pour construire les URL de redirection Stripe
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (monitoring d'erreurs) — laisser vide tant que le compte n'est pas créé, Sentry.init
# reste alors un no-op (voir sentry.server.config.ts / sentry.edge.config.ts / instrumentation-client.ts)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optionnels, pour l'upload des source maps à la build uniquement (voir next.config.mjs)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
