generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String         @id // = Clerk organization id
  name                 String
  plan                 String         @default("trial") // trial, starter, pro, agency — voir lib/billing/plans.ts
  stripeCustomerId     String?        @unique // créé au premier passage par le checkout Stripe
  stripeSubscriptionId String?        @unique // abonnement actif ; null si résilié ou jamais souscrit
  createdAt            DateTime       @default(now())
  users                User[]
  programs             Program[]
  usageCounters        UsageCounter[]
  brandVoicePresets    BrandVoicePreset[]
}

model User {
  id             String   @id // = Clerk user id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role     @default(COLLABORATEUR)
  email          String
  name           String?
  createdAt      DateTime @default(now())

  programAccess ProgramAccess[]
  generatedBy   GeneratedContent[]

  @@index([organizationId])
}

enum Role {
  ADMIN
  PROMOTEUR
  COLLABORATEUR
}

model Program {
  id                String   @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  address           String?
  city              String
  district          String?
  description       String?
  deliveryDate      DateTime?
  programType       String? // neuf, rénové, ...
  unitsCount        Int?
  environment       String?
  transport         String?
  schools           String?
  shops             String?
  pointsOfInterest  String?
  amenities         String?
  features          String?
  advantages        String?
  isCoOwnership     Boolean  @default(false) // soumis au statut de la copropriété (loi de 1965)
  condoLotsCount    Int? // nombre de lots de la copropriété — mention obligatoire si isCoOwnership
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lots               Lot[]
  access             ProgramAccess[]
  contents           GeneratedContent[]
  generationRequests GenerationRequest[]

  @@index([organizationId])
}

// Scoping des collaborateurs : accès explicite programme par programme
model ProgramAccess {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
}

model Lot {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  reference       String
  propertyType    String // T1, T2, maison, ...
  roomsCount      Int?
  livingArea      Float?
  outdoorArea     Float?
  floor           Int?
  orientation     String?
  exposure        String?
  view            String?
  hasBalcony      Boolean  @default(false)
  hasTerrace      Boolean  @default(false)
  hasGarden       Boolean  @default(false)
  hasParking      Boolean  @default(false)
  hasCellar       Boolean  @default(false)
  hasEquippedKitchen Boolean  @default(false)
  isFurnished        Boolean  @default(false)
  furnishedEquipment String[] // meubles/équipements présents si isFurnished (lit, canapé, ...)
  dpeEnergyClass  String? // classe énergie A-G, ou "vierge" (bien neuf VEFA non encore diagnostiqué)
  dpeGesClass     String? // classe climat (GES) A-G
  condoAnnualCharges Float? // quote-part de charges annuelles de copropriété pour ce lot — mention obligatoire si program.isCoOwnership
  price           Float?
  pricePerSqm     Float?
  availability    String? // disponible, réservé, vendu
  specialFeatures String?
  customFields    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contents GeneratedContent[]
  photos   LotPhoto[]

  @@index([programId])
}

// Photos d'un lot, stockées en base pour être envoyées telles quelles au modèle de
// vision (pas de dépendance à un stockage de fichiers externe) : la génération de
// description ancrée sur photo ne décrit que ce qui y est réellement visible.
model LotPhoto {
  id        String   @id @default(cuid())
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())

  @@index([lotId])
}

// Une "requête de génération" = un clic sur Générer, avec ses paramètres marketing
model GenerationRequest {
  id             String   @id @default(cuid())
  programId      String
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lotId          String?
  organizationId String
  requestedById  String
  positioning    String[] // premium, familial, investissement, ...
  target         String?
  tone           String?
  languageLevel  String?
  length         String?
  commercialGoal String?
  mainArgument   String?
  cta            String?
  requestedTypes String[] // ["listing_full", "instagram", "video_30s_emotion", ...]
  promptVersion  String
  status         String   @default("pending") // pending, done, failed
  createdAt      DateTime @default(now())

  contents GeneratedContent[]

  @@index([organizationId])
  @@index([programId])
}

// Un contenu généré individuel = régénérable/éditable indépendamment
model GeneratedContent {
  id                   String            @id @default(cuid())
  generationRequestId  String
  generationRequest    GenerationRequest @relation(fields: [generationRequestId], references: [id], onDelete: Cascade)
  programId            String
  program              Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  lotId                String?
  lot                  Lot?              @relation(fields: [lotId], references: [id])
  type                 String // listing_full, listing_short, portal, website, instagram,
                                // facebook, linkedin, tiktok, video_script
  angle                String? // emotion, investissement, visite, storytelling, urgence
  duration             Int? // pour les scripts vidéo (30, 45, 60)
  content              Json
  // Index de variante A/B (0/1/2, voir VARIANT_TONE_PRESETS) : null si généré hors A/B. Nécessaire
  // pour que la régénération d'une variante donnée puisse reconstruire la même nuance de ton —
  // sans ça, GenerationRequest.tone ne stocke que le ton de base, jamais l'ajustement par variante.
  variantIndex         Int?
  status               String   @default("current") // current, edited, archived
  approvalStatus       String   @default("draft") // draft, pending_review, approved — workflow de validation avant diffusion
  // Stats de performance après publication manuelle (Instagram/TikTok...). Saisie manuelle pour
  // l'instant : la publication automatique et la récupération via API ne sont pas encore branchées
  // (nécessite une app Meta/TikTok validée par leur revue).
  externalPostUrl        String?
  externalLikes          Int?
  externalViews          Int?
  externalComments       Int?
  externalStatsUpdatedAt DateTime?
  editedByUserId       String?
  createdByUserId      String
  createdBy            User     @relation(fields: [createdByUserId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([programId])
  @@index([generationRequestId])
}

model UsageCounter {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  generationsUsed  Int      @default(0)
  generationsQuota Int

  @@unique([organizationId, periodStart])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  key       String // "listing_full", "video_script", ...
  version   Int
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([key, version])
}

model Feedback {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  message        String
  page           String? // chemin de la page depuis laquelle le feedback a été envoyé
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

// Préréglage de ton/marque réutilisable à chaque génération (ex: "Luxe", "Familial",
// "Investissement"), pour garder une voix de marque cohérente entre collaborateurs.
model BrandVoicePreset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  target         String?
  tone           String?
  mainArgument   String?
  cta            String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
